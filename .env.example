# Frontend (Vite) env vars
VITE_API_BASE=
VITE_JOBS_API_BASE=/api/jobs

# Local job service. Never place secret keys in VITE_ variables.
JOB_AUTH_MODE=firebase
JOB_LOCAL_TOKEN=
JOB_API_PORT=8787
JOB_API_HOST=127.0.0.1
JOB_DATA_DIR=.studentpilot/jobs
FIREBASE_PROJECT_ID=
JOB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BRAVE_SEARCH_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
ENABLE_APPLICATION_BROWSER=false
APPLICATION_BROWSER_EXECUTABLE=
LATEX_IMAGE=studentpilot-latex:local

# Gemini (client-side)
VITE_GEMINI_API_KEY=
VITE_GEMINI_TEXT_MODEL=gemini-2.5-flash
VITE_GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Firebase (if used)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
